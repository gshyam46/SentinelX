# ============================================
# SentinelX Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# --- Database ---
DATABASE_URL=postgresql+asyncpg://sentinelx:sentinelx_secret@localhost:5433/sentinelx
SYNC_DATABASE_URL=postgresql://sentinelx:sentinelx_secret@localhost:5433/sentinelx

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
SECRET_KEY=change-this-to-a-random-64-char-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM (via LiteLLM — supports any provider) ---
LITELLM_MODEL=groq/llama-3.1-70b-versatile
GROQ_API_KEY=your-groq-api-key
# Optional: for switching providers later
# OPENAI_API_KEY=your-openai-key
# ANTHROPIC_API_KEY=your-anthropic-key

# --- External APIs ---
SHODAN_API_KEY=your-shodan-api-key
HIBP_API_KEY=your-hibp-api-key
OTX_API_KEY=your-otx-api-key

# --- App Config ---
APP_NAME=SentinelX
APP_ENV=development
LOG_LEVEL=INFO
MAX_FREE_SCANS_PER_DAY=3
